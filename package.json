{
  "name": "olgas-cheese-kiosk",
  "version": "0.1.0",
  "private": true,
  "description": "Self-service kiosk for Olga's Cheese: order on a tablet, pay by card on a SumUp Solo, receipt straight to a USB printer. Talks to the Olga's Cheese POS through its API.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "readers": "tsx scripts/readers.ts",
    "pair": "tsx scripts/pair-reader.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
