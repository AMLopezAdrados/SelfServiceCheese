# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
# Everything here stays on the kiosk server; the kiosk page never sees it.

# Port of the kiosk server (the tablet opens http(s)://<server>:<port>/).
PORT=8080

# Optional shared key. When set, the tablet must open the kiosk once as
#   https://<server>/?key=<KIOSK_ACCESS_KEY>
# (it is remembered), and every other caller gets 401.
KIOSK_ACCESS_KEY=

# PIN for the staff panel on the kiosk (tap the logo 5 times).
KIOSK_STAFF_PIN=1234

# Public HTTPS address of this server, e.g. https://kiosk.olgascheese.net.
# Only used for SumUp's return_url (SumUp requires HTTPS); leave empty when
# the server is not publicly reachable — the kiosk polls SumUp anyway.
KIOSK_PUBLIC_URL=

# --- Olga's Cheese POS ------------------------------------------------------
# API base of the POS, including /api in production.
POS_URL=https://pos.olgascheese.net/api
# A separate POS staff account for the kiosk (role staff is enough).
POS_USERNAME=kiosk
POS_PIN=
# Optional: the event to sell for. Empty = the one BX event with an open day.
POS_EVENT_ID=

# --- SumUp Solo (Cloud API) ------------------------------------------------
# Secret API key from the SumUp dashboard (Developers → API keys).
SUMUP_API_KEY=
# Merchant code of the SumUp account (e.g. MC0X8ABC).
SUMUP_MERCHANT_CODE=
# Affiliate key + its application id (SumUp dashboard → Affiliate keys).
SUMUP_AFFILIATE_KEY=
SUMUP_APP_ID=
# The Solo next to the kiosk: the rdr_… id from `npm run pair` / `npm run readers`.
SUMUP_READER_ID=

# --- Trying it without a Solo ----------------------------------------------
# true = a virtual Solo instead of SumUp (nothing is charged).
SUMUP_MOCK=false
# successful | declined | timeout | offline, and how long a payment takes (ms).
SUMUP_MOCK_OUTCOME=successful
SUMUP_MOCK_DELAY_MS=6000
